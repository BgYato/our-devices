/* Estilos para login */
QWidget {
    background-color: #080e1a;
    color: #e2e8f0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
}

/* Labels */
QLabel {
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 500;
}

#logoTitle {
    font-size: 48px;
    font-weight: 700;
    color: #ffffff;
}

#logoSubtitle {
    font-size: 16px;
    color: #a7b5c8;
    line-height: 1.5;
}

QWidget#leftPanel {
    background-color: #101a2a;
    border: 1px solid #1e2b40;
    border-radius: 18px;
}

QWidget#rightPanel {
    background-color: #0d1625;
    border: 1px solid #1e2b40;
    border-radius: 18px;
}

/* Inputs */
QLineEdit {
    background-color: #111b2b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 13px 15px;
    color: #f1f5f9;
    font-size: 14px;
    margin-bottom: 12px;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
}

/* Boton de login */
QPushButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 14px 24px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3b82f6;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton:disabled {
    background-color: #475569;
    color: #94a3b8;
}